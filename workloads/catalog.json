      "base": "agent",
      "path": "extensions/vertex-ai/index.ts",
      "required": true
    },
    "web-access": {
      "kind": "package",
      "base": "agent",
      "path": "npm/node_modules/pi-web-access",
      "packageName": "pi-web-access",
      "version": "0.13.0",
      "extension": "index.ts"
    },
    "chrome": {
      "kind": "package",
      "base": "agent",
      "path": "npm/node_modules/pi-chrome",
      "packageName": "pi-chrome",
      "version": "0.15.46",
      "extension": "extensions/chrome-profile-bridge/index.ts"
    },
    "plannotator": {
      "kind": "package",
      "base": "agent",
      "path": "npm/node_modules/@plannotator/pi-extension",
      "packageName": "@plannotator/pi-extension",
      "version": "0.24.1",
      "extension": "index.ts"
    },
    "hashline-edit": {
      "kind": "package",
      "base": "agent",
      "path": "npm/node_modules/pi-hashline-edit",
      "packageName": "pi-hashline-edit",
      "version": "0.8.3",
      "extension": "index.ts"
    },
    "lsp": {
      "kind": "package",
      "base": "agent",
      "path": "npm/node_modules/pi-lsp",
      "packageName": "pi-lsp",
      "version": "0.1.7",
      "extension": "extensions/pi-lsp/index.ts"
    },
    "engineering": {
      "kind": "package",
      "base": "agent",
      "path": "packages/pi-workbench",
      "packageName": "@danish/pi-engineering",
      "version": "0.2.0",
      "extension": "extensions/index.ts"
    },
    "research": {
      "kind": "package",
      "base": "agent",
      "path": "packages/pi-research",
      "packageName": "@danish/pi-research",
      "version": "0.1.0",
      "extension": "extensions/index.ts"
    }
  },
  "skills": {
    "engineering": {
      "base": "resource",
      "resource": "engineering",
      "path": "skills/pi-engineering"
    },
    "web-librarian": {
      "base": "resource",
      "resource": "web-access",
      "path": "skills/librarian"

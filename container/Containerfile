ARG NODE_IMAGE=node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d
FROM ${NODE_IMAGE}

ARG PI_VERSION=0.83.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      build-essential \
      ca-certificates \
      curl \
      fd-find \
      git \
      iproute2 \
      jq \
      less \
      openssh-client \
      procps \
      python3 \
      python3-venv \
      ripgrep \
      tini \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && npm install --global --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p \
      /home/pi \
      /opt/pi-harness \
      /state/base-agent/extensions \
      /state/base-agent/npm/node_modules/@earendil-works \
      /state/base-agent/npm/node_modules \
      /state/base-agent/packages \
      /state/base-agent/workbench/writer-leases \
      /state/shared-skills \
    && touch \
      /state/base-agent/auth.json \
      /state/base-agent/models-store.json \
      /state/base-agent/settings.json

# Selected host extensions resolve Pi's peer APIs through the exact Pi runtime
# baked into this image instead of mounting a second host copy and its graph.
RUN test -f /usr/local/lib/node_modules/@earendil-works/pi-coding-agent/package.json \
    && test -f /usr/local/lib/node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai/package.json \
    && test -f /usr/local/lib/node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-tui/package.json \
    && test -f /usr/local/lib/node_modules/@earendil-works/pi-coding-agent/node_modules/typebox/package.json \
    && ln -s /usr/local/lib/node_modules/@earendil-works/pi-coding-agent \
      /state/base-agent/npm/node_modules/@earendil-works/pi-coding-agent \
    && ln -s /usr/local/lib/node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai \
      /state/base-agent/npm/node_modules/@earendil-works/pi-ai \
    && ln -s /usr/local/lib/node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-tui \
      /state/base-agent/npm/node_modules/@earendil-works/pi-tui \
    && ln -s /usr/local/lib/node_modules/@earendil-works/pi-coding-agent/node_modules/typebox \
      /state/base-agent/npm/node_modules/typebox

ARG HARNESS_SHA256=unknown
LABEL io.pi-harness.image-schema="1" \
      io.pi-harness.pi-version="${PI_VERSION}" \
      io.pi-harness.payload-sha256="${HARNESS_SHA256}"

COPY . /opt/pi-harness

WORKDIR /home/pi

CMD ["/opt/pi-harness/container/bootstrap.sh"]

{
  "name": "@daniishkhan/pi-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A portable, sanitized bundle of Pi extensions, skills, agents, prompts, themes, and setup defaults.",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/check.mjs && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit && tsc -p packages/pi-computer-use/tsconfig.json --noEmit && tsc -p packages/pi-teams/tsconfig.json --noEmit",
    "test": "node scripts/test-computer-use.mjs && node scripts/test-pi-teams.mjs",
    "install:setup": "node scripts/install.mjs"
  },
  "dependencies": {
    "@playwright/cli": "0.1.18"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/questionnaire.ts",
      "./extensions/lean-startup.ts",
      "./extensions/nodes-qwen.ts",
      "./extensions/session-forks/index.ts",
      "./extensions/vertex-ai/index.ts",
      "./packages/pi-computer-use/extensions/computer-use/index.ts",
      "./packages/pi-teams/index.ts"
    ],
    "skills": [
      "./skills",
      "./packages/pi-computer-use/skills",
      "./packages/pi-teams/skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
